# Exemplo sem credenciais reais.
# O script scripts/homologacao_local.ps1 gera .env.homolog.local com valores
# aleatorios e nao versionados. Nao use estes placeholders fora da validacao de
# configuracao do Docker Compose.

HOMOLOG_POSTGRES_PASSWORD=change-me-local-postgres
HOMOLOG_JWT_SECRET_KEY=change-me-local-jwt-with-at-least-32-characters
HOMOLOG_PAYMENT_CONFIG_ENCRYPTION_KEY=change-me-local-encryption-key
HOMOLOG_USER_EMAIL=homologacao@corepet.test
HOMOLOG_USER_PASSWORD=change-me-local-password
HOMOLOG_TENANT_NAME=CorePet Homologacao Local

